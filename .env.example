# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Database (Settings → Database → Connection string → URI)
DATABASE_URL=postgresql://postgres.your-project-ref:[password]@aws-0-region.pooler.supabase.com:6543/postgres

# Server
PORT=8080
CORS_ORIGIN=http://localhost:5173

# Temporary dev user UUID — replaced by real JWT auth in Phase 5
# Create a user in Supabase Auth dashboard and paste their UUID here
DEV_USER_ID=your-supabase-user-uuid
